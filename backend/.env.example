# =============================================================================
# DUPON CAPACITY PLANNER - Configuración de Entorno
# =============================================================================
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA commitees el archivo `.env` al repositorio (está en .gitignore).
# Para producción, usa GCP Secret Manager en lugar de variables de entorno.
# =============================================================================

# Base de Datos PostgreSQL (Docker local, puerto 5435 para evitar colisiones)
# Estas variables son usadas tanto por docker-compose (POSTGRES_USER/PASSWORD)
# como por FastAPI via DATABASE_URL. Single source of truth de credenciales.
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD_SEGURA>
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD_SEGURA>@localhost:5435/dcp_db_dev

# Conexión XML-RPC a Odoo Staging
ODOO_URL=https://<TU_INSTANCIA>.odoo.com
ODOO_DB=<NOMBRE_BASE_DATOS_ODOO>
ODOO_USER=<EMAIL_USUARIO_ODOO>
ODOO_API_KEY=<API_KEY_ODOO>

# Seguridad JWT
# Genera un secreto de 256 bits criptográficamente seguro con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# o usando:
#   openssl rand -hex 32
JWT_SECRET=<GENERA_CON_openssl_rand_hex_32>
JWT_ALGORITHM=HS256
# TTL reducido recomendado: 60-120 minutos. Aumentar solo con refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Motor de Sincronización con Odoo
# Intervalo en minutos para obtener actualizaciones incrementales de Odoo.
SYNC_INTERVAL_MINUTES=30
