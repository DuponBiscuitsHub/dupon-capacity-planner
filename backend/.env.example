# Database Connection Configuration
# Mapped to local Docker PostgreSQL on port 5435 to avoid collisions
DATABASE_URL=postgresql://dcp_admin:dcp_local_password123@localhost:5435/dcp_db_dev

# Odoo ERP Staging XML-RPC Connection
ODOO_URL=https://staging-instance.odoo.com
ODOO_DB=staging_db_name
ODOO_USER=staging_user_email
ODOO_API_KEY=your_staging_api_key_or_password

# Authentication JWT Security Configurations
# Generate a secure 32-byte secret key in production
JWT_SECRET=dcp_super_secret_key_for_local_development_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sync Engine Configuration
# Interval in minutes for pulling incremental updates from Odoo
SYNC_INTERVAL_MINUTES=30
