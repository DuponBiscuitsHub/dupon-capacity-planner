# =============================================================================
# DCP Raw Material Planner — Configuración de Entorno
# =============================================================================
# Copia este archivo como `backend/.env` y rellena los valores reales.
# NUNCA commitees .env al repositorio (está en .gitignore).
# En producción: variables inyectadas desde GCP Secret Manager.
# =============================================================================

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME="DCP Raw Material Planner"
APP_ENV=development        # development | production

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
DB_USER=dcp_user
DB_PASSWORD=<contraseña_segura>
DATABASE_URL=postgresql://dcp_user:<contraseña_segura>@localhost:5435/dcp_db_dev

# ── Conexión JSON-RPC a Odoo ──────────────────────────────────────────────────
# ODOO_MODE=mock  → sin conexión real (desarrollo / CI)
# ODOO_MODE=real  → conecta a Odoo real (beta / producción)
ODOO_MODE=mock
ODOO_URL=https://<instancia>.odoo.com
ODOO_DB=<nombre_base_datos_odoo>
ODOO_USER=<email_usuario_odoo>
ODOO_API_KEY=<api_key_odoo>   # Settings → Technical → API Keys
# Para rotar la API key de staging tras un rebuild de Odoo:
#   python -m scripts.rotate_odoo_key --key "nueva_key"
#   python -m scripts.rotate_odoo_key --verify   # solo verificar conexión
ODOO_TIMEOUT_SECONDS=15

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=<genera_con_openssl_rand_hex_32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Sincronización ────────────────────────────────────────────────────────────
# Intervalo en segundos (900 = 15 min)
SYNC_INTERVAL_SECONDS=900
